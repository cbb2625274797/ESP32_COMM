menu "ESP32_COMM Configuration"

    config ESP_WIFI_SSID
        string "WiFi SSID"
        default "ESP32_OTA_RELAY"

    config ESP_WIFI_PASSWORD
        string "WiFi Password"
        default "12345678"

    config ESP_WIFI_CHANNEL
        int "WiFi Channel"
        range 1 13
        default 6

    config ESP_MAX_STA_CONN
        int "Max STA connections"
        default 4

endmenu
