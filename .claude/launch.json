{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev-server",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "8080"],
      "port": 8080,
      "autoPort": true
    },
    {
      "name": "tools-server",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "8080", "--directory", "tools"],
      "port": 8080,
      "autoPort": true
    }
  ]
}
